# =============================================================================
# Copy to .env or .env.local as needed (see sections below).
# =============================================================================

# -----------------------------------------------------------------------------
# Vite — use .env.local (optional)
# -----------------------------------------------------------------------------
# Only VITE_* names are exposed to the browser. Do not put secrets in VITE_*.
# The app currently does not read VITE_* variables (same-origin /api; map style in code).

# -----------------------------------------------------------------------------
# Lambda env — copy keys below into .env (repo root)
# -----------------------------------------------------------------------------
# Picked up by `npm run sam:local` / `npm run dev:stack` via scripts/sam-local.mjs
# (merged with sam/env.json.example + optional sam/env.json). Not read by Vite.
#
# --- SearchAreasFunction (lambda/search-areas.ts) ---
# Transit journey commute (TfL Unified API; app_key query param only).
TFL_APP_KEY=
# Driving / cycling / walking directions (not transit; use TfL for transit).
ORS_API_KEY=
# UK HPI live borough prices: omit or any value except 0 = fetch Land Registry JSON;
# 0 = static in-repo borough medians only (recommended for heavy local dev).
UKHPI_LIVE=0
#
# --- GeocodeWorkplaceFunction (lambda/geocode-workplace.ts) ---
# Optional; when empty, workplace geocoding uses Nominatim.
MAPBOX_ACCESS_TOKEN=
# Max POST /api/geocode-workplace per client IP per minute (warm Lambda only). 0 = disable.
GEOCODE_RATE_LIMIT_PER_MINUTE=30
#
# --- HealthFunction ---
# (no environment variables)

# -----------------------------------------------------------------------------
# AWS SAM deploy — not read from .env by sam local; use sam deploy / console
# -----------------------------------------------------------------------------
# template.yaml Parameters → Lambda env where noted:
#   TflAppKey              → TFL_APP_KEY (SearchAreasFunction)
#   OrsApiKey              → ORS_API_KEY (SearchAreasFunction)
#   MapboxAccessToken      → MAPBOX_ACCESS_TOKEN (GeocodeWorkplaceFunction)
#   CorsAdditionalOrigin   → API Gateway CORS only (extra browser origin; localhost:5173 always allowed)
#
# Example:
#   sam deploy --parameter-overrides TflAppKey=... OrsApiKey=... MapboxAccessToken=... CorsAdditionalOrigin=https://your-site.example
