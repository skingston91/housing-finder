# =============================================================================
# Vite (copy this file to .env.local)
# =============================================================================
# Only names prefixed with VITE_ are exposed to the browser — never put secrets
# in VITE_*.
#
# The current app does not read any VITE_* variables (map style is fixed in
# code; API calls use same-origin /api).

# =============================================================================
# Lambda / SAM (not loaded from .env.local)
# =============================================================================
# Set for deploy via template.yaml Parameters (TflAppKey, MapboxAccessToken) or
# AWS console / Parameter Store. For sam local, copy sam/env.json.example to
# sam/env.json — see docs/development.md.
#
# SearchAreasFunction
# TFL_APP_KEY=          # TfL Unified API app_key (optional; enables journey-based transit commute)
# ORS_API_KEY=          # OpenRouteService API key (optional; driving/cycling/walking directions — not transit)
# UKHPI_LIVE=           # Omit or any value except 0 = fetch UK HPI borough averages (Land Registry); 0 = static medians only
#
# GeocodeWorkplaceFunction
# MAPBOX_ACCESS_TOKEN=  # Optional Mapbox token; when empty, workplace geocoding uses Nominatim
# GEOCODE_RATE_LIMIT_PER_MINUTE=30  # Max geocode POSTs per client IP per minute (0 = disable; warm Lambda only)
